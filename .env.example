# 本番 VM で docker compose を動かすときの環境変数（ローカル開発では使わない）。
# ローカル開発は従来どおり dotnet run + ローカル Supabase（appsettings.Development.json / launchSettings.json）。

# --- バックエンド ---
# Program.cs で必須の2つ。本番ではリポジトリ内に値が無く、現状は Azure App Service の構成で渡している値と同じものを入れる。
# 接続文字列は GitHub Secrets の SUPABASE_DB_CONNECTION_STRING（db-migrate-prod.yml が使用）と同じ形式。
ConnectionStrings__Supabase=Host=<Session Pooler host>;Port=5432;Database=postgres;Username=postgres.<PROJECT_REF>;Password=<DB_PASSWORD>;SSL Mode=Require
Supabase__ProjectUrl=https://<PROJECT_REF>.supabase.co

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=

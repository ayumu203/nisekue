# docker-compose.yml 用の環境変数。.env にコピーして値を埋める（.env はコミットしない）。

# --- バックエンド (ASP.NET Core の設定キー。":" は "__" に置き換える) ---
# Supabase の Session Pooler 接続文字列
ConnectionStrings__Supabase=Host=aws-0-ap-northeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<PROJECT_REF>;Password=<DB_PASSWORD>;SSL Mode=Require
Supabase__ProjectUrl=https://<PROJECT_REF>.supabase.co
Supabase__JwtAudience=authenticated
Cors__AllowedOrigins__0=https://game.arm203.org

# --- Cloudflare Tunnel ---
# Zero Trust > Networks > Tunnels で作成したトンネルのトークン
CLOUDFLARE_TUNNEL_TOKEN=

# --- 任意 ---
# IMAGE_TAG=latest
# CLOUDFLARED_TAG=latest
# ASPNETCORE_ENVIRONMENT=Production

# 本番 VM で docker compose を動かすときの環境変数（ローカル開発では使わない）。
# ローカル開発は従来どおり dotnet run + ローカル Supabase（appsettings.Development.json / launchSettings.json）。

# --- バックエンド ---
# Program.cs で必須の2つ。本番ではリポジトリ内に値が無く、現状は Azure App Service の構成で渡している値と同じものを入れる。
# 接続文字列は GitHub Secrets の SUPABASE_DB_CONNECTION_STRING（db-migrate-prod.yml が使用）と同じ形式。
ConnectionStrings__Supabase=Host=<Session Pooler host>;Port=5432;Database=postgres;Username=postgres.<PROJECT_REF>;Password=<DB_PASSWORD>;SSL Mode=Require
Supabase__ProjectUrl=https://<PROJECT_REF>.supabase.co

# /internal/* のメンテナンス用エンドポイントの認証トークン（Maintenance:MarketCleanupToken）。
# GitHub Secrets の MARKET_CLEANUP_TOKEN（cleanup-quest-data-* / ranking-rebuild-* が送信）および
# active-reporter Worker が送る X-Maintenance-Token と同じ値にする。未設定だと /internal/* が 503 を返す。
Maintenance__MarketCleanupToken=

# スレッド画像の保存先（Cloudflare R2）。5項目がそろっていないと画像の投稿は受け付けない（画像なしのスレッドは作れる）。
# R2 の API トークンは「Object Read & Write」・対象はこのバケットのみに絞り、ステージングとは別のトークンにする。
ThreadImageStorage__R2AccountId=
ThreadImageStorage__R2AccessKeyId=
ThreadImageStorage__R2SecretAccessKey=
ThreadImageStorage__R2BucketName=
# バケットに紐付けた公開用カスタムドメイン（例: https://img.arm203.org）
ThreadImageStorage__PublicBaseUrl=
# 画像を消したときに Cloudflare のキャッシュもパージする（任意）。トークンは Zone の Cache Purge 権限のみ
ThreadImageStorage__CachePurgeZoneId=
ThreadImageStorage__CachePurgeApiToken=

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=

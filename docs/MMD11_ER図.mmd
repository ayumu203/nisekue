erDiagram
    PLAYERS {
        uuid id PK "internal.players.id"
        varchar(20) name "NOT NULL"
        varchar(255) image_path "NULL"
        int job "NOT NULL, DEFAULT 1 (Apprentice)"
        int level "NOT NULL, DEFAULT 1"
        int exp "NOT NULL, DEFAULT 0"
        int max_hp "NOT NULL, DEFAULT 1"
        int max_mp "NOT NULL, DEFAULT 0"
        int strength "NOT NULL, DEFAULT 0"
        int defense "NOT NULL, DEFAULT 0"
        int intelligence "NOT NULL, DEFAULT 0"
        int luck "NOT NULL, DEFAULT 0"
        int speed "NOT NULL, DEFAULT 0"
        int training_battle_count "NOT NULL, DEFAULT 0"
        timestamptz training_cooldown_until "NULL"
    }
    CHAT_ROOMS {
        uuid owner_id PK, FK "internal.players.id"
        int last_chat_id "NOT NULL, DEFAULT 0"
    }
    CHAT_MESSAGES {
        uuid owner_id PK, FK "internal.chat_rooms.owner_id"
        uuid sender_id FK "internal.players.id, NOT NULL"
        int chat_id PK "NOT NULL"
        varchar(200) message "NOT NULL"
        timestamptz created_at "NOT NULL, DEFAULT CURRENT_TIMESTAMP"
    }
    PLAYER_MOVES {
        uuid player_id PK, FK "internal.players.id"
        int move_id_1 "NULL (references CSV move_id logically)"
        int move_id_2 "NULL (references CSV move_id logically)"
        int move_id_3 "NULL (references CSV move_id logically)"
        int move_id_4 "NULL (references CSV move_id logically)"
        int move_id_5 "NULL (references CSV move_id logically)"
        int move_id_6 "NULL (references CSV move_id logically)"
        int move_id_7 "NULL (references CSV move_id logically)"
        int move_id_8 "NULL (references CSV move_id logically)"
        int move_id_9 "NULL (references CSV move_id logically)"
        int move_id_10 "NULL (references CSV move_id logically)"
    }

    PLAYERS ||--|| CHAT_ROOMS : owns
    CHAT_ROOMS ||--o{ CHAT_MESSAGES : has
    PLAYERS ||--|| PLAYER_MOVES : has_slots

classDiagram
    %% Enum 定義は docs/MMD21_Enum.mmd を参照
    namespace CoreDomain {
        %% Player の基本情報
        class Player {
            <<Entity>>
            +PlayerId Id
            +string Name
            +string? ImagePath
            +DateTimeOffset? QuestCooldownUntil
            +Job Job
            +IReadOnlySet~Job~ MasteredJobs
            +int Level
            +int Exp
            +int JobLevel
            +int JobExp
            +Status Status
            +MoveSet MoveSet
            +PlayerEquipmentLoadout EquipmentLoadout
            +UpdateName(name: string) void
            +UpdateImagePath(imagePath: string?) void
            +ChangeJob(nextJob: Job, nextProfile: JobProfile, learningRule: JobMoveLearningRule) IReadOnlyList~MoveId~
            +UpdateStatus(status: Status) void
            +UpdateMoveSet(moveSet: MoveSet) void
            +UpdateEquipmentLoadout(loadout: PlayerEquipmentLoadout) void
            +SetQuestCooldownUntil(until: DateTimeOffset?) void
            -ValidateName(name: string) string
            -ValidateImagePath(imagePath: string?) string?
            +GainExp(exp: int) void
            +LevelUp(jobProfile: JobProfile, learningRule: JobMoveLearningRule) LevelUpResult
            -CanChangeJob(nextProfile: JobProfile) bool
            -MarkCurrentJobAsMastered(jobProfile: JobProfile) bool
            -SynchronizeLearnableMoves(jobProfile: JobProfile, learningRule: JobMoveLearningRule) IReadOnlyList~MoveId~
        }

        class PlayerId {
            <<Value Object>>
            +Guid Id
        }

        class Status {
            <<Value Object>>
            +int MaxHp
            +int MaxMp
            +int Strength
            +int Defense
            +int Intelligence
            +int Luck
            +int Speed
        }

        class EquipmentType {
            <<enumeration>>
            Weapon
            Armor
        }

        class EquipmentStatus {
            <<enumeration>>
            Inventory
            Equipped
            Broken
        }

        class EquipmentId {
            <<Value Object>>
            +int Id
        }

        class PlayerEquipmentId {
            <<Value Object>>
            +Guid Id
        }

        class Equipment {
            <<Aggregate Root>>
            +EquipmentId Id
            +string Name
            +EquipmentType Type
            +int MaxDurability
            +Status BonusValues
            +IReadOnlySet~Job~ EquippableJobs
            +bool CanEquip(job: Job) bool
        }

        class PlayerEquipment {
            <<Entity>>
            +PlayerEquipmentId Id
            +PlayerId PlayerId
            +EquipmentId EquipmentId
            +EquipmentType Type
            +EquipmentStatus Status
            +int Durability
            +int Mastery
            +bool IsBroken
            +Equip(equipmentType: EquipmentType, equipment: Equipment) void
            +Unequip() void
            +ConsumeDurability(value: int) void
            +IncreaseMastery(value: int) void
            +MarkBroken() void
        }

        class PlayerEquipmentLoadout {
            <<Value Object>>
            +PlayerEquipmentId? WeaponEquipmentId
            +PlayerEquipmentId? ArmorEquipmentId
            +Assign(equipmentType: EquipmentType, equipmentId: PlayerEquipmentId?) PlayerEquipmentLoadout
            +GetEquippedIds() IReadOnlyList~PlayerEquipmentId~
        }

        class EquipmentStatusResolver {
            <<Domain Service>>
            +BuildEffectiveStatus(baseStatus: Status, equipments: IEnumerable~PlayerEquipment~, masters: IEnumerable~Equipment~) Status
        }

        class GrowthValue {
            <<Value Object>>
            +int MaxHp
            +int MaxMp
            +int Strength
            +int Defense
            +int Intelligence
            +int Luck
            +int Speed
        }

        class JobProfile {
            <<Value Object>>
            +Job Job
            +string Description
            +int MasterLevel
            +IReadOnlyList~Job~ RequiredMasterJobs
        }

        class LevelUpResult {
            <<Value Object>>
            +bool HasLeveledUp
            +bool HasMasteredCurrentJob
            +IReadOnlyList~MoveId~ NewlyLearnedMoveIds
        }

        class MoveSet {
            <<Value Object>>
            +IReadOnlyList~MoveId?~ Slots
            +SetSlot(index: int, moveId: MoveId?) void
            +GetSlot(index: int) MoveId?
            +GetLearnedMoveIds() IReadOnlyList~MoveId~
            +Contains(moveId: MoveId) bool
            +AddLearnedMove(moveId: MoveId) void
            +GetFirstEmptySlotIndex() int?
            +ClearSlot(index: int) void
            +SwapSlots(fromIndex: int, toIndex: int) void
            -DropOldestMoveBySetLimit() void
        }

        class IPlayerRepository {
            +Task~Player?~ GetPlayerAsync(id: PlayerId)
            +Task~IReadOnlyList~Player~~ GetAllAsync()
            +Task~bool~ UpdateNameAsync(id: PlayerId, name: string)
            +Task~DateTimeOffset?~ TryStartTrainingCooldownAsync(id: PlayerId, nowUtc: DateTimeOffset, cooldown: TimeSpan)
            +Task SetQuestCooldownUntilAsync(id: PlayerId, until: DateTimeOffset?)
            +Task SaveAsync(player: Player)
        }

        class IEquipmentRepository {
            +Task~Equipment?~ GetAsync(id: EquipmentId)
            +Task~IReadOnlyList~Equipment~~ GetAllAsync()
        }

        class IPlayerEquipmentRepository {
            +Task~IReadOnlyList~PlayerEquipment~~ GetByPlayerAsync(playerId: PlayerId)
            +Task~PlayerEquipment?~ GetAsync(playerEquipmentId: PlayerEquipmentId)
            +Task SaveAsync(playerEquipments: IReadOnlyList~PlayerEquipment~)
        }

        class IJobProfileRepository {
            +JobProfile GetByJob(job: Job)
            +IReadOnlyList~JobProfile~ GetAll()
        }
    }

    Player *-- PlayerId : has
    Player *-- Status : has
    Player *-- MoveSet : has
    Player *-- PlayerEquipmentLoadout : has
    PlayerEquipment *-- PlayerEquipmentId : has
    PlayerEquipment ..> Equipment : refers
    PlayerEquipment ..> EquipmentStatus : has
    Equipment *-- EquipmentId : has
    Equipment ..> EquipmentType : has
    PlayerEquipmentLoadout ..> PlayerEquipmentId : refers
    Player ..> JobMoveLearningRule : uses
    Player ..> LevelUpResult : returns
    EquipmentStatusResolver ..> Equipment : uses
    EquipmentStatusResolver ..> PlayerEquipment : uses
    IJobProfileRepository ..> JobProfile : returns
    IPlayerRepository ..> Player : stores/loads
    IEquipmentRepository ..> Equipment : stores/loads
    IPlayerEquipmentRepository ..> PlayerEquipment : stores/loads

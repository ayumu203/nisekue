classDiagram
    %% Enum 定義は docs/MMD21_Enum.mmd を参照

    namespace StageContext {
        class QuestStageDefinition {
            <<Aggregate Root>>
            +QuestStageId Id
            +string StageCode
            +string Name
            +string BattlefieldImagePath
            +int RecommendedLevel
            +int MinPartyMemberCount
            +int MaxPartyMemberCount
            +IReadOnlyList~QuestFloorDefinition~ Floors
            +IReadOnlyList~QuestStageEquipmentRewardEntry~ EquipmentRewards
            +bool IsActive
        }

        class QuestStageSummaryView {
            <<Application DTO>>
            +QuestStageId StageId
            +string StageCode
            +string Name
            +string BattlefieldImagePath
            +int RecommendedLevel
            +string? PreviewEnemyImagePath
        }

        class QuestStageId {
            <<Value Object>>
            +int Id
        }

        class QuestFloorDefinition {
            <<Entity>>
            +int FloorNo
            +FloorType FloorType
            +IReadOnlyList~QuestEnemyPlacement~ Placements
            +QuestFloorRewardRule RewardRule
        }

        class QuestFloorRewardRule {
            <<Value Object>>
            +decimal ExpRate
            +decimal GoldRate
        }

        class QuestStageEquipmentRewardEntry {
            <<Value Object>>
            +EquipmentId? EquipmentId
            +int Weight
            +bool IsMiss
        }

        class QuestEnemyPlacement {
            <<Entity>>
            +int PlacementNo
            +QuestEnemyDefinitionId EnemyDefinitionId
            +BattlePosition Position
        }

        class QuestEnemyDefinition {
            <<Aggregate Root>>
            +QuestEnemyDefinitionId Id
            +string Name
            +int Level
            +Status Status
            +string ImagePath
            +EnemyAiType AiType
            +IReadOnlyList~MoveId~ MoveIds
        }

        class QuestEnemyDefinitionId {
            <<Value Object>>
            +int Id
        }

        class QuestNpcTemplate {
            <<Aggregate Root>>
            +QuestNpcTemplateId Id
            +string Name
            +Job Job
            +BattleRow PreferredRow
            +int Level
            +Status BaseStatus
            +IReadOnlyList~MoveId~ MoveIds
            +NpcRole Role
        }

        class QuestNpcTemplateId {
            <<Value Object>>
            +int Id
        }

        class IQuestStageRepository {
            +Task~QuestStageDefinition?~ GetAsync(id: QuestStageId)
            +Task~QuestStageDefinition?~ GetByStageCodeAsync(stageCode: string)
        }

        class IQuestNpcTemplateRepository {
            +Task~IReadOnlyList~QuestNpcTemplate~~ GetForStartAsync(stageId: QuestStageId, count: int)
        }

        class IQuestEnemyDefinitionRepository {
            +Task~QuestEnemyDefinition?~ GetAsync(id: QuestEnemyDefinitionId)
        }

        class CsvQuestStageRepository {
            <<Infrastructure>>
        }

        class CsvQuestNpcTemplateRepository {
            <<Infrastructure>>
        }

        class StageNpcTemplateRow {
            <<CSV Row>>
            +QuestStageId StageId
            +QuestNpcTemplateId[] NpcTemplateIds
        }

        class CsvQuestEnemyDefinitionRepository {
            <<Infrastructure>>
        }

        QuestStageDefinition ..> QuestStageSummaryView : first placement enemy image for UI preview
    }

    namespace RoomContext {
        class QuestNpcImageAssignmentPolicy {
            <<Application Policy>>
            +Resolve(participantId: QuestParticipantId, npcTemplateId: QuestNpcTemplateId?) string
        }

        class BattlePosition {
            <<Value Object>>
            +BattleRow Row
            +BattleColumn Column
        }

        class FormationLayout {
            <<Value Object>>
            +IReadOnlyList~BattlePosition~ OccupiedPositions
            +Assign(participantId: QuestParticipantId, position: BattlePosition) void
            +Release(position: BattlePosition) void
            +IsOccupied(position: BattlePosition) bool
            +FindFirstEmpty(preferredRow: BattleRow?) BattlePosition
        }

        class QuestRoom {
            <<Aggregate Root>>
            +QuestRoomId Id
            +PlayerId OwnerId
            +QuestStageId StageId
            +QuestRoomMode Mode
            +QuestRoomStatus Status
            +int Version
            +FormationLayout Formation
            +QuestRoomJoinPolicy JoinPolicy
            +IReadOnlyList~QuestParticipant~ Participants
            +QuestRoomCloseReason? CloseReason
            +DateTimeOffset CreatedAt
            +DateTimeOffset? ClosedAt
            +AddPlayer(playerId: PlayerId, displayName: string, level: int) void
            +UpdateJoinPolicy(minRequiredLevel: int?, allowedPlayerIds: IReadOnlyList~PlayerId~) void
            +AssignPosition(participantId: QuestParticipantId, position: BattlePosition) void
            +MarkDisconnected(participantId: QuestParticipantId, at: DateTimeOffset) void
            +MarkReconnected(participantId: QuestParticipantId, at: DateTimeOffset) void
            +RemoveParticipant(participantId: QuestParticipantId, at: DateTimeOffset) void
            +CanStart() bool
            +AddNpcParticipants(npcTemplates: IEnumerable~QuestNpcTemplate~) void
            +CloseRecruitment(reason: QuestRoomCloseReason, at: DateTimeOffset) void
            +CancelForOwnerRoomReplacement(at: DateTimeOffset) void
            +CancelByOwner(at: DateTimeOffset) void
        }

        class QuestRoomId {
            <<Value Object>>
            +Guid Id
        }

        class QuestRoomJoinPolicy {
            <<Value Object>>
            +int? MinRequiredLevel
            +IReadOnlyList~PlayerId~ AllowedPlayerIds
            +CanJoin(playerId: PlayerId, level: int) bool
        }

        class QuestParticipant {
            <<Entity>>
            +QuestParticipantId Id
            +ParticipantType Type
            +PlayerId? PlayerId
            +QuestNpcTemplateId? NpcTemplateId
            +string DisplayName
            +ParticipantStatus Status
            +BattlePosition Position
            +bool IsOwner
            +DateTimeOffset JoinedAt
            +DateTimeOffset? LastSeenAt
            +DateTimeOffset? LeftAt
        }

        QuestParticipant ..> QuestNpcImageAssignmentPolicy : UI image for npc participants

        class QuestParticipantId {
            <<Value Object>>
            +Guid Id
        }

        class IQuestRoomRepository {
            +Task~QuestRoom?~ GetAsync(id: QuestRoomId)
            +Task~QuestRoom?~ GetRecruitingByOwnerAsync(ownerId: PlayerId)
            +Task~IReadOnlyList~QuestRoom~~ SearchAsync(condition: QuestRoomSearchCondition)
            +Task SaveAsync(room: QuestRoom)
        }

        class QuestRoomSearchCondition {
            <<Value Object>>
            +QuestStageId? StageId
            +QuestRoomMode? Mode
            +QuestRoomStatus? Status
            +PlayerId? OwnerPlayerId
            +PlayerId? ViewerPlayerId
            +int Page
            +int PageSize
        }
    }

    namespace RunContext {
        class QuestRunPartyMemberSnapshot {
            <<Value Object>>
            +QuestParticipantId ParticipantId
            +ParticipantType Type
            +string DisplayName
            +string? ImagePath
            +Job Job
            +Status BaseStatus
            +PlayerEquipmentId? WeaponEquipmentId
            +PlayerEquipmentId? ArmorEquipmentId
            +MoveSet MoveSet
            +BattlePosition StartPosition
            +ActionMode InitialActionMode
        }

        class QuestRunParticipantIdentity {
            <<Value Object>>
            +QuestParticipantId ParticipantId
            +PlayerId? PlayerId
            +bool IsOwner
        }

        class QuestRun {
            <<Aggregate Root>>
            +QuestRunId Id
            +QuestRoomId RoomId
            +PlayerId OwnerPlayerId
            +QuestStageId StageId
            +QuestRunStatus Status
            +QuestFloorState FloorState
            +QuestBattleState BattleState
            +QuestTurnState TurnState
            +QuestTrapCollection Traps
            +QuestRewardAccumulator Rewards
            +IReadOnlyList~QuestRunParticipantIdentity~ ParticipantIdentities
            +IReadOnlyList~QuestChatMessage~ ChatMessages
            +DateTimeOffset StartedAt
            +DateTimeOffset? EndedAt
            +InitializeFirstFloor() void
            +SubmitCommand(participantId: QuestParticipantId, command: QuestSubmittedCommand, now: DateTimeOffset) void
            +SwitchToAutoActionForTimeout(now: DateTimeOffset) void
            +RequestManualControl(participantId: QuestParticipantId) void
            +ApproveManualControl(participantId: QuestParticipantId, ownerId: PlayerId) void
            +ApplyBattleResolution(resolution: BattleTurnResolution, partyActorMap: IReadOnlyDictionary~BattleActorId, QuestParticipantId~, enemyActorMap: IReadOnlyDictionary~BattleActorId, QuestEnemyInstanceId~, finalFloorNo: int, nextDeadlineAt: DateTimeOffset) QuestRunResolutionSummary
            +AdvanceFloor() void
            +ApplyTrapsOnFloorStart() void
            +EscapeByOwner() void
            +MarkSucceeded() void
            +MarkFailed() void
            +Abort(reason: string) void
            +AddChatMessage(message: QuestChatMessage) void
        }

        class QuestRunId {
            <<Value Object>>
            +Guid Id
        }

        class QuestFloorState {
            <<Value Object>>
            +int CurrentFloorNo
            +bool IsBossFloor
            +IReadOnlyList~QuestEnemyPlacement~ CurrentPlacements
        }

        class QuestBattleState {
            <<Value Object>>
            +IReadOnlyList~QuestRunPartyMemberState~ PartyMembers
            +IReadOnlyList~QuestEnemyState~ Enemies
        }

        class QuestRunPartyMemberState {
            <<Entity>>
            +QuestParticipantId ParticipantId
            +int CurrentHp
            +int CurrentMp
            +bool IsDead
            +int CanActFromTurn
            +ActionMode ActionMode
            +ManualControlRequestStatus ManualControlRequestStatus
        }

        class QuestEnemyState {
            <<Entity>>
            +QuestEnemyInstanceId Id
            +QuestEnemyDefinitionId EnemyDefinitionId
            +BattlePosition Position
            +int CurrentHp
            +int CurrentMp
            +bool IsDead
        }

        class QuestEnemyInstanceId {
            <<Value Object>>
            +Guid Id
        }

        class QuestTurnState {
            <<Value Object>>
            +int CurrentTurnNo
            +DateTimeOffset ActionDeadlineAt
            +int? LastResolvedTurnNo
            +IReadOnlyList~QuestSubmittedCommand~ PendingCommands
        }

        class QuestSubmittedCommand {
            <<Entity>>
            +QuestParticipantId ParticipantId
            +int TurnNo
            +ActionKind ActionKind
            +BattlePosition? SelectedTargetPosition
            +DateTimeOffset SubmittedAt
            +bool IsAutoSubmitted
        }

        class QuestTrapCollection {
            <<Value Object>>
            +IReadOnlyList~QuestTrapState~ Traps
        }

        class QuestChatMessage {
            <<Value Object>>
            +int TurnNo
            +QuestParticipantId SenderParticipantId
            +string DisplayName
            +string? ImagePath
            +string Message
            +DateTimeOffset SentAt
        }

        class QuestTrapState {
            <<Entity>>
            +QuestTrapId Id
            +QuestParticipantId SourceParticipantId
            +MoveId MoveId
            +int ExpiresAfterFloorNo
            +bool IsTriggered
        }

        class QuestTrapId {
            <<Value Object>>
            +Guid Id
        }

        class QuestRewardAccumulator {
            <<Value Object>>
            +int Exp
            +int Gold
            +EquipmentId? RewardEquipmentId
            +AddExp(value: int) void
            +AddGold(value: int) void
            +SetRewardEquipment(equipmentId: EquipmentId?) void
        }

        class QuestRewardEquipmentGrant {
            <<Value Object>>
            +PlayerId PlayerId
            +EquipmentId? EquipmentId
            +bool IsSkippedByInventoryFull
        }

        class QuestRunResolutionSummary {
            <<Value Object>>
            +int Turn
            +bool IsFloorCleared
            +bool IsQuestCompleted
            +bool IsQuestFailed
        }

        class IQuestRunRepository {
            +Task~QuestRun?~ GetAsync(id: QuestRunId)
            +Task~QuestRun?~ GetByRoomIdAsync(roomId: QuestRoomId)
            +Task~bool~ ExistsActiveRunByPlayerAsync(playerId: PlayerId)
            +Task SaveAsync(run: QuestRun)
        }
    }

    namespace ServiceContext {
        class QuestResponseMapper {
            <<Application Service>>
            +Task~object~ MapQuestRoomSummaryAsync(room: QuestRoom)
            +Task~object~ MapQuestRoomDetailAsync(room: QuestRoom)
            +Task~object~ MapQuestRunDetailAsync(run: QuestRun)
        }

        class QuestRoomService {
            <<Application Service>>
            +Task~QuestRoom~ CreateRoomAsync(ownerId: PlayerId, stageId: QuestStageId, mode: QuestRoomMode, minRequiredLevel: int?, allowedPlayerIds: IReadOnlyList~PlayerId~)
            +Task~QuestRoom~ JoinRoomAsync(roomId: QuestRoomId, playerId: PlayerId)
            +Task~QuestRoom~ CancelRoomAsync(roomId: QuestRoomId, ownerId: PlayerId)
            +Task~QuestRoom~ UpdateRestrictionsAsync(roomId: QuestRoomId, ownerId: PlayerId, minRequiredLevel: int?, allowedPlayerIds: IReadOnlyList~PlayerId~)
            +Task~IReadOnlyList~QuestRoom~~ ListAsync(condition: QuestRoomSearchCondition)
            +Task~QuestRun~ StartAsync(roomId: QuestRoomId)
        }

        class QuestNpcAssignmentService {
            <<Application Service>>
            +Task~IReadOnlyList~QuestNpcTemplate~~ AssignForStart(room: QuestRoom, minPartyMemberCount: int)
        }

        class QuestSnapshotFactory {
            <<Application Service>>
            +Create(participants: IEnumerable~QuestParticipant~, players: IEnumerable~Player~, npcTemplates: IEnumerable~QuestNpcTemplate~, playerEquipments: IEnumerable~PlayerEquipment~, equipments: IEnumerable~Equipment~) QuestRunPartyMemberSnapshot[]
        }

        class QuestBattleFactory {
            <<Application Service>>
            +CreateActorSnapshots(snapshots: IEnumerable~QuestRunPartyMemberSnapshot~) BattleActorSnapshot[]
            +CreateEnemySnapshots(definitions: IEnumerable~QuestEnemyDefinition~, placements: IEnumerable~QuestEnemyPlacement~) BattleActorSnapshot[]
            +CreateInitialStates(partySnapshots: IEnumerable~QuestRunPartyMemberSnapshot~, enemyDefinitions: IEnumerable~QuestEnemyDefinition~) BattleActorState[]
            +CreateBattleActions(commands: IEnumerable~QuestSubmittedCommand~) BattleAction[]
            +CreateBattleFieldContext(partySnapshots: IEnumerable~QuestRunPartyMemberSnapshot~, placements: IEnumerable~QuestEnemyPlacement~) BattleFieldContext
        }

        class QuestAllyNpcActionPolicy {
            <<Domain Service>>
            +SelectAction(run: QuestRun, participantId: QuestParticipantId, availableMoves: IReadOnlyList~Move~) QuestSubmittedCommand
        }

        class QuestRunFactory {
            <<Application Service>>
            +Create(stageDefinition: QuestStageDefinition, snapshots: IEnumerable~QuestRunPartyMemberSnapshot~, now: DateTimeOffset) QuestRun
        }

        class QuestRunOutcomeJudge {
            <<Domain Service>>
            +Judge(run: QuestRun, resolution: BattleTurnResolution) QuestRunResolutionSummary
        }

        class QuestRunService {
            <<Application Service>>
            +Task~QuestRun~ GetDetailAsync(runId: QuestRunId, playerId: PlayerId)
            +Task~QuestRun~ SubmitCommandAsync(runId: QuestRunId, playerId: PlayerId, command: QuestSubmittedCommand)
            +Task~QuestRun~ EscapeAsync(runId: QuestRunId, ownerPlayerId: PlayerId)
            +Task~QuestRun~ RequestManualControlAsync(runId: QuestRunId, playerId: PlayerId)
            +Task~QuestRun~ ApproveManualControlAsync(runId: QuestRunId, ownerPlayerId: PlayerId, participantId: QuestParticipantId)
            +Task~int~ ProcessExpiredRunsAsync(now: DateTimeOffset)
            -GrantStageRewardsAsync(run: QuestRun, now: DateTimeOffset) IReadOnlyList~QuestRewardEquipmentGrant~
        }

        class QuestStageRewardLotteryService {
            <<Domain Service>>
            +Draw(stage: QuestStageDefinition) EquipmentId?
        }
    }

    QuestStageDefinition *-- QuestStageId : has

    QuestFloorDefinition *-- QuestEnemyPlacement : 0..*
    QuestEnemyDefinition *-- QuestEnemyDefinitionId : has
    QuestNpcTemplate *-- QuestNpcTemplateId : has
    QuestRoom *-- QuestRoomId : has
    QuestRoom *-- FormationLayout : has
    QuestRoom *-- QuestRoomJoinPolicy : has
    QuestRoom *-- QuestParticipant : 1..*
    QuestParticipant *-- QuestParticipantId : has
    QuestParticipant *-- BattlePosition : has
    QuestRun *-- QuestRunId : has
    QuestRun *-- QuestFloorState : has
    QuestRun *-- QuestBattleState : has
    QuestRun *-- QuestTurnState : has
    QuestRun *-- QuestTrapCollection : has
    QuestRun *-- QuestRewardAccumulator : has
    QuestRun *-- QuestRewardEquipmentGrant : 0..*
    QuestRun *-- QuestRunParticipantIdentity : 1..*
    QuestRun *-- QuestChatMessage : 0..*
    QuestFloorState *-- QuestEnemyPlacement : 0..*
    QuestBattleState *-- QuestRunPartyMemberState : 1..*
    QuestBattleState *-- QuestEnemyState : 1..*
    QuestEnemyState *-- QuestEnemyInstanceId : has
    QuestTurnState *-- QuestSubmittedCommand : 0..*
    QuestTrapCollection *-- QuestTrapState : 0..*
    QuestTrapState *-- QuestTrapId : has
    IQuestStageRepository ..> QuestStageDefinition : loads
    IQuestRoomRepository ..> QuestRoom : stores/loads
    IQuestRoomRepository ..> QuestRoomSearchCondition : searches
    IQuestRunRepository ..> QuestRun : stores/loads
    IQuestNpcTemplateRepository ..> QuestNpcTemplate : loads
    IQuestEnemyDefinitionRepository ..> QuestEnemyDefinition : loads
    CsvQuestStageRepository ..|> IQuestStageRepository : implements
    CsvQuestNpcTemplateRepository ..|> IQuestNpcTemplateRepository : implements
    CsvQuestNpcTemplateRepository ..> StageNpcTemplateRow : loads
    CsvQuestEnemyDefinitionRepository ..|> IQuestEnemyDefinitionRepository : implements
    QuestRoomService ..> IQuestStageRepository : use
    QuestRoomService ..> IQuestRoomRepository : use
    QuestRoomService ..> QuestRoom : use
    QuestRoomService ..> QuestRun : starts
    QuestResponseMapper ..> IQuestStageRepository : use
    QuestResponseMapper ..> IQuestEnemyDefinitionRepository : use
    QuestResponseMapper ..> IPlayerRepository : use

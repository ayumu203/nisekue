erDiagram
    %% 転生は既存 internal.players の rebirth_count / level / exp / job_level / job_exp / gold / status 系カラム更新で表現する
    %% player_moves と player_master_jobs は維持し、転生回数は internal.players.rebirth_count で保持する
    PLAYERS {
        uuid id PK "internal.players.id"
        varchar(20) name "NOT NULL"
        varchar(255) image_path "NULL"
        int job "NOT NULL, DEFAULT 1 (Apprentice)"
        int rebirth_count "NOT NULL, DEFAULT 0"
        int level "NOT NULL, DEFAULT 1"
        int exp "NOT NULL, DEFAULT 0"
        int job_level "NOT NULL, DEFAULT 1"
        int job_exp "NOT NULL, DEFAULT 0"
        int max_hp "NOT NULL, DEFAULT 1"
        int max_mp "NOT NULL, DEFAULT 0"
        int strength "NOT NULL, DEFAULT 0"
        int defense "NOT NULL, DEFAULT 0"
        int intelligence "NOT NULL, DEFAULT 0"
        int luck "NOT NULL, DEFAULT 0"
        int speed "NOT NULL, DEFAULT 0"
        int gold "NOT NULL, DEFAULT 100"
        int training_battle_count "NOT NULL, DEFAULT 0"
        timestamptz training_cooldown_until "NULL"
        timestamptz quest_cooldown_until "NULL"
        timestamptz pet_battle_cooldown_until "NULL"
        int exp_multiplier_flags "NOT NULL, DEFAULT 0"
        int endless_best_floor "NOT NULL, DEFAULT 0, エンドレスモード最高到達フロア"
    }
    CHAT_ROOMS {
        uuid owner_id PK, FK "internal.players.id"
        int last_chat_id "NOT NULL, DEFAULT 0"
    }
    CHAT_MESSAGES {
        uuid owner_id PK, FK "internal.chat_rooms.owner_id"
        int sender_type "NOT NULL (Player/System)"
        uuid sender_id FK "internal.players.id, NULL when system"
        int chat_id PK "NOT NULL"
        varchar(200) message "NOT NULL"
        timestamptz created_at "NOT NULL, DEFAULT CURRENT_TIMESTAMP"
        boolean is_alerted "NOT NULL, DEFAULT FALSE"
    }
    THREADS {
        uuid id PK "internal.threads.id"
        uuid author_player_id FK "internal.players.id"
        varchar(50) title "NOT NULL"
        varchar(500) body "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
        timestamptz last_replied_at "NULL"
    }
    THREAD_REPLIES {
        uuid id PK "internal.thread_replies.id"
        uuid thread_id FK "internal.threads.id"
        uuid author_player_id FK "internal.players.id"
        varchar(250) body "NOT NULL"
        timestamptz created_at "NOT NULL"
        boolean is_author_alerted "NOT NULL, DEFAULT FALSE"
    }
    PLAYER_MOVES {
        uuid player_id PK, FK "internal.players.id"
        int move_id_1 "NULL (references CSV move_id logically)"
        int move_id_2 "NULL (references CSV move_id logically)"
        int move_id_3 "NULL (references CSV move_id logically)"
        int move_id_4 "NULL (references CSV move_id logically)"
        int move_id_5 "NULL (references CSV move_id logically)"
        int move_id_6 "NULL (references CSV move_id logically)"
        int move_id_7 "NULL (references CSV move_id logically)"
        int move_id_8 "NULL (references CSV move_id logically)"
        int move_id_9 "NULL (references CSV move_id logically)"
        int move_id_10 "NULL (references CSV move_id logically)"
    }
    PLAYER_MASTER_JOBS {
        uuid player_id PK, FK "internal.players.id"
        int job PK "mastered job enum value"
        timestamptz mastered_at "NOT NULL"
    }
    PLAYER_REBIRTH_STATUS_HISTORIES {
        uuid id PK "internal.player_rebirth_status_histories.id"
        uuid player_id FK "internal.players.id"
        int rebirth_count "NOT NULL, その転生の通算回数 (転生後の rebirth_count 値), UNIQUE(player_id, rebirth_count)"
        int max_hp "NOT NULL, 転生直前(前世ピーク)のステータス"
        int max_mp "NOT NULL"
        int strength "NOT NULL"
        int defense "NOT NULL"
        int intelligence "NOT NULL"
        int luck "NOT NULL"
        int speed "NOT NULL"
        timestamptz rebirthed_at "NOT NULL"
    }
    PLAYER_EQUIPMENTS {
        uuid id PK "internal.player_equipments.id"
        uuid player_id FK "internal.players.id"
        int equipment_id "NOT NULL, references CSV equipment_id logically"
        int equipment_type "NOT NULL, duplicated for query/use-case simplicity"
        int equipment_status "NOT NULL (Inventory/Equipped/Broken)"
        int durability "NOT NULL"
        int mastery "NOT NULL, DEFAULT 0"
        int plus_value "NOT NULL, DEFAULT 0"
        timestamptz acquired_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }
    PLAYER_ITEM_STACKS {
        uuid id PK "internal.player_item_stacks.id"
        uuid player_id FK "internal.players.id"
        int item_id "NOT NULL, references CSV item_id logically (normal item and treasure map shared id space)"
        int quantity "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }
    PLAYER_PETS {
        uuid id PK "internal.player_pets.id"
        uuid player_id FK "internal.players.id, 1プレイヤー上限3体（アプリ層で制御）"
        int enemy_definition_id "NOT NULL, references CSV enemy definition id logically"
        int bonus_max_hp "NOT NULL, DEFAULT 0, 育成加算分"
        int bonus_max_mp "NOT NULL, DEFAULT 0"
        int bonus_strength "NOT NULL, DEFAULT 0"
        int bonus_defense "NOT NULL, DEFAULT 0"
        int bonus_intelligence "NOT NULL, DEFAULT 0"
        int bonus_luck "NOT NULL, DEFAULT 0"
        int bonus_speed "NOT NULL, DEFAULT 0"
        boolean is_standby "NOT NULL, DEFAULT FALSE, 呼出対象は1プレイヤー1体のみTRUE（部分一意制約で保証）"
        timestamptz captured_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }
    MARKET_LISTINGS {
        uuid id PK "internal.market_listings.id"
        uuid seller_id FK "internal.players.id"
        uuid player_equipment_id FK "NULL, internal.player_equipments.id"
        int item_id "NULL, references CSV item_id logically"
        varchar(100) item_name "NOT NULL"
        varchar(500) flavor_text "NOT NULL"
        int quantity "NOT NULL"
        int remaining_quantity "NOT NULL"
        int unit_price "NOT NULL"
        timestamptz listed_at "NOT NULL"
        timestamptz expires_at "NOT NULL"
    }
    MARKET_TRADE_HISTORIES {
        uuid id PK "internal.market_trade_histories.id"
        uuid seller_id FK "internal.players.id"
        uuid buyer_id FK "internal.players.id"
        varchar(50) item_id "NOT NULL, equipment_id or item_id as persisted identifier"
        int quantity "NOT NULL"
        int unit_price "NOT NULL"
        timestamptz purchased_at "NOT NULL"
    }
    ITEM_DELETE_LOGS {
        uuid id PK "internal.item_delete_logs.id"
        uuid player_id FK "internal.players.id"
        varchar(50) item_id "NOT NULL, equipment_id or item_id as persisted identifier"
        int quantity "NOT NULL"
        varchar(50) reason "NOT NULL"
        timestamptz deleted_at "NOT NULL"
    }
    QUEST_ROOMS {
        uuid id PK "internal.quest_rooms.id"
        uuid owner_player_id FK "internal.players.id"
        int stage_id "references CSV quest stage id logically"
        int mode "NOT NULL (Solo/Multi)"
        int status "NOT NULL (Recruiting/Closed)"
        int min_required_level "NULL"
        int version "NOT NULL, optimistic concurrency token"
        int close_reason "NULL (Started/Cancelled/Expired)"
        timestamptz created_at "NOT NULL"
        timestamptz closed_at "NULL"
    }
    QUEST_ROOM_ALLOWED_PLAYERS {
        uuid room_id PK, FK "internal.quest_rooms.id"
        uuid player_id PK, FK "internal.players.id"
        timestamptz added_at "NOT NULL"
    }
    QUEST_ROOM_PARTICIPANTS {
        uuid id PK "internal.quest_room_participants.id"
        uuid room_id FK "internal.quest_rooms.id"
        int participant_type "NOT NULL (Player/Npc)"
        uuid player_id FK "NULL, internal.players.id"
        int npc_template_id "NULL, references CSV npc template id logically"
        varchar(100) display_name "NOT NULL"
        int battle_row "NOT NULL"
        int battle_column "NOT NULL"
        int participant_status "NOT NULL (Joined/Disconnected/Left)"
        boolean is_owner "NOT NULL"
        timestamptz joined_at "NOT NULL"
        timestamptz last_seen_at "NULL"
        timestamptz left_at "NULL"
    }
    QUEST_RUNS {
        uuid id PK "internal.quest_runs.id"
        uuid room_id FK "UNIQUE, internal.quest_rooms.id"
        int stage_id "references CSV quest stage id logically"
        int status "NOT NULL (InProgress/Succeeded/Failed/Aborted)"
        int current_floor_no "NOT NULL"
        int current_turn_no "NOT NULL"
        timestamptz action_deadline_at "NOT NULL"
        int last_resolved_turn_no "NULL"
        jsonb last_turn_results_json "NULL, only latest turn result"
        jsonb chat_messages_json "NOT NULL, quest chat message array"
        timestamptz started_at "NOT NULL"
        timestamptz ended_at "NULL"
        int version "NOT NULL, optimistic concurrency token"
    }
    QUEST_RUN_PARTY_SNAPSHOTS {
        uuid run_id PK, FK "internal.quest_runs.id"
        uuid participant_id PK, FK "internal.quest_room_participants.id"
        int participant_type "NOT NULL (Player/Npc)"
        varchar(100) display_name "NOT NULL"
        varchar(255) image_path "NULL"
        int job "NOT NULL"
        uuid weapon_player_equipment_id "NULL, internal.player_equipments.id"
        uuid armor_player_equipment_id "NULL, internal.player_equipments.id"
        int start_row "NOT NULL"
        int start_column "NOT NULL"
        int max_hp "NOT NULL"
        int max_mp "NOT NULL"
        int strength "NOT NULL"
        int defense "NOT NULL"
        int intelligence "NOT NULL"
        int luck "NOT NULL"
        int speed "NOT NULL"
        jsonb move_set_json "NOT NULL"
        int initial_action_mode "NOT NULL"
        int pet_enemy_definition_id "NULL, クエスト参加時点のスタンバイペット, references CSV enemy definition id logically"
        int pet_max_hp "NULL, 敵マスタ+育成加算の合算値"
        int pet_max_mp "NULL"
        int pet_strength "NULL"
        int pet_defense "NULL"
        int pet_intelligence "NULL"
        int pet_luck "NULL"
        int pet_speed "NULL"
    }
    QUEST_RUN_PARTY_MEMBERS {
        uuid run_id PK, FK "internal.quest_runs.id"
        uuid participant_id PK, FK "internal.quest_room_participants.id"
        int current_hp "NOT NULL"
        int current_mp "NOT NULL"
        boolean is_dead "NOT NULL"
        int can_act_from_turn "NOT NULL"
        int action_mode "NOT NULL (Manual/AutoAttackOnly)"
        int pet_summons_used "NOT NULL, DEFAULT 0, 上限3"
        jsonb active_effects_json "NOT NULL, ailments and buffs"
        jsonb derived_parameters_json "NOT NULL, temporary modifiers"
        timestamptz updated_at "NOT NULL"
    }
    QUEST_RUN_ENEMIES {
        uuid run_id PK, FK "internal.quest_runs.id"
        uuid enemy_instance_id PK "generated per run"
        int floor_no "NOT NULL"
        int enemy_definition_id "references CSV enemy definition id logically"
        int battle_row "NOT NULL"
        int battle_column "NOT NULL"
        int current_hp "NOT NULL"
        int current_mp "NOT NULL"
        boolean is_dead "NOT NULL"
        boolean is_captured "NOT NULL, DEFAULT FALSE, 捕獲された敵は報酬対象外"
        jsonb active_effects_json "NOT NULL, ailments and buffs"
        jsonb derived_parameters_json "NOT NULL, temporary modifiers"
    }
    QUEST_TURN_COMMANDS {
        uuid run_id PK, FK "internal.quest_runs.id"
        int turn_no PK "NOT NULL"
        uuid participant_id PK, FK "internal.quest_room_participants.id"
        int action_kind "NOT NULL"
        int move_id "NULL, references CSV move id logically"
        int target_row "NULL"
        int target_column "NULL"
        timestamptz submitted_at "NOT NULL"
        boolean is_auto_submitted "NOT NULL"
    }
    QUEST_FLOOR_TRAPS {
        uuid run_id PK, FK "internal.quest_runs.id"
        uuid trap_id PK "generated per trap"
        uuid source_participant_id FK "internal.quest_room_participants.id"
        int move_id "NOT NULL, references CSV move id logically"
        int expires_after_floor_no "NOT NULL"
        boolean is_triggered "NOT NULL"
    }
    QUEST_REWARD_SUMMARIES {
        uuid run_id PK, FK "internal.quest_runs.id"
        int exp "NOT NULL"
        int equipment_reward_id "NULL, references CSV equipment_id logically"
        int item_reward_id "NULL, references CSV item_id logically"
        jsonb skipped_reward_player_ids_json "NOT NULL"
    }

    TREASURE_MAP_EXPEDITIONS {
        uuid id PK "internal.treasure_map_expeditions.id"
        uuid player_id FK "internal.players.id"
        int map_id "NOT NULL, references CSV treasure_maps.id logically"
        timestamptz started_at "NOT NULL"
        timestamptz ends_at "NOT NULL"
        int status "NOT NULL (InProgress/Completed/Claimed/Failed)"
        jsonb reward_summary_json "NULL, serialized items/equipment/gold/exp"
        boolean reward_claimed "NOT NULL, DEFAULT FALSE"
        timestamptz completed_at "NULL, set when status becomes Completed or Failed"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }
    TREASURE_MAP_CLAIM_HISTORIES {
        uuid id PK "internal.treasure_map_claim_histories.id"
        uuid player_id FK "internal.players.id"
        uuid expedition_id FK "internal.treasure_map_expeditions.id"
        jsonb reward_summary_json "NOT NULL, reward snapshot for audit"
        timestamptz claimed_at "NOT NULL"
    }

    RANKING_SNAPSHOTS {
        uuid id PK "internal.ranking_snapshots.id"
        timestamptz snapshot_at "NOT NULL, schedule aligned timestamp"
        int interval_hours "NOT NULL, DEFAULT 6"
        timestamptz created_at "NOT NULL"
    }

    RANKING_ENTRIES {
        uuid id PK "internal.ranking_entries.id"
        uuid snapshot_id FK "internal.ranking_snapshots.id"
        varchar(80) ranking_type "NOT NULL"
        varchar(20) period_kind "NOT NULL (Total/Weekly/Daily)"
        varchar(20) combat_index_rank "NULL, SSS- G for rank scoped rankings"
        uuid player_id FK "internal.players.id"
        int rank_position "NOT NULL, 1-based"
        bigint score "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    GLOBAL_CHAT_ROOMS {
        uuid id PK "internal.global_chat_rooms.id, 固定UUID（シングルロー）"
        int last_chat_id "NOT NULL, DEFAULT 0"
    }
    GLOBAL_CHAT_MESSAGES {
        int chat_id PK "internal.global_chat_messages.chat_id"
        int sender_type "NOT NULL (Player/System)"
        uuid sender_id FK "internal.players.id, NULL when system"
        varchar(200) message "NOT NULL"
        timestamptz created_at "NOT NULL, DEFAULT CURRENT_TIMESTAMP"
    }

    PLAYERS ||--|| CHAT_ROOMS : owns
    CHAT_ROOMS ||--o{ CHAT_MESSAGES : has
    GLOBAL_CHAT_ROOMS ||--o{ GLOBAL_CHAT_MESSAGES : has
    PLAYERS ||--o{ THREADS : authors
    THREADS ||--o{ THREAD_REPLIES : has
    PLAYERS ||--o{ THREAD_REPLIES : authors
    PLAYERS ||--|| PLAYER_MOVES : has_slots
    PLAYERS ||--o{ PLAYER_MASTER_JOBS : has_mastered
    PLAYERS ||--o{ PLAYER_REBIRTH_STATUS_HISTORIES : records_rebirth
    PLAYERS ||--o{ PLAYER_EQUIPMENTS : owns
    PLAYERS ||--o{ PLAYER_ITEM_STACKS : owns
    PLAYERS ||--o{ PLAYER_PETS : owns
    PLAYERS ||--o{ MARKET_LISTINGS : sells
    PLAYERS ||--o{ MARKET_TRADE_HISTORIES : sells_or_buys
    PLAYERS ||--o{ ITEM_DELETE_LOGS : deletes
    PLAYERS ||--o{ QUEST_ROOMS : owns
    PLAYERS ||--o{ QUEST_ROOM_ALLOWED_PLAYERS : can_be_allowed_for
    QUEST_ROOMS ||--o{ QUEST_ROOM_PARTICIPANTS : has
    QUEST_ROOMS ||--o{ QUEST_ROOM_ALLOWED_PLAYERS : allows
    QUEST_RUNS ||--o{ QUEST_RUN_PARTY_SNAPSHOTS : snapshots
    QUEST_RUNS ||--o{ QUEST_RUN_PARTY_MEMBERS : tracks_party
    QUEST_RUNS ||--o{ QUEST_RUN_ENEMIES : tracks_enemies
    QUEST_RUNS ||--o{ QUEST_TURN_COMMANDS : receives
    QUEST_RUNS ||--o{ QUEST_FLOOR_TRAPS : carries
    QUEST_RUNS ||--|| QUEST_REWARD_SUMMARIES : awards
    QUEST_RUNS ||--o{ QUEST_REWARD_EQUIPMENTS : grants
    PLAYERS ||--o{ TREASURE_MAP_EXPEDITIONS : begins
    PLAYERS ||--o{ TREASURE_MAP_CLAIM_HISTORIES : claims
    TREASURE_MAP_EXPEDITIONS ||--o{ TREASURE_MAP_CLAIM_HISTORIES : claimed_by
    RANKING_SNAPSHOTS ||--o{ RANKING_ENTRIES : has
    PLAYERS ||--o{ RANKING_ENTRIES : ranked_in

    PLAYER_PET_BATTLE_STATS {
        uuid player_id PK, FK "internal.players.id"
        int rating "NOT NULL, DEFAULT 1000, ペットバトルレートポイント"
        int wins "NOT NULL, DEFAULT 0"
        int losses "NOT NULL, DEFAULT 0"
        int total_battles "NOT NULL, DEFAULT 0"
        timestamptz updated_at "NOT NULL"
    }

    PET_BATTLE_ROOMS {
        uuid id PK "internal.pet_battle_rooms.id"
        uuid owner_player_id FK "internal.players.id"
        uuid opponent_player_id FK "internal.players.id"
        int status "NOT NULL (WaitingForStart/Closed), owner_player_id は WaitingForStart 中のみ UNIQUE"
        int version "NOT NULL, optimistic concurrency token"
        int close_reason "NULL (Started/Cancelled)"
        timestamptz created_at "NOT NULL"
        timestamptz closed_at "NULL"
    }

    PET_BATTLE_ROOM_SLOTS {
        uuid room_id PK, FK "internal.pet_battle_rooms.id"
        uuid pet_id PK, FK "internal.player_pets.id"
        int battle_row "NOT NULL"
        int battle_column "NOT NULL"
    }

    PET_BATTLE_RUNS {
        uuid id PK "internal.pet_battle_runs.id"
        uuid room_id FK "UNIQUE, internal.pet_battle_rooms.id"
        uuid owner_player_id FK "internal.players.id"
        uuid opponent_player_id FK "internal.players.id"
        int status "NOT NULL (InProgress/Succeeded/Failed/Aborted), owner_player_id は InProgress 中のみ UNIQUE"
        int current_turn_no "NOT NULL"
        timestamptz action_deadline_at "NOT NULL"
        int last_resolved_turn_no "NULL"
        jsonb last_turn_results_json "NULL, only latest turn result"
        uuid winner_player_id FK "NULL, internal.players.id"
        timestamptz started_at "NOT NULL"
        timestamptz ended_at "NULL"
    }

    PET_BATTLE_RUN_SNAPSHOTS {
        uuid run_id PK, FK "internal.pet_battle_runs.id"
        uuid participant_id PK "generated per slot"
        int side "NOT NULL (Owner/Opponent)"
        uuid pet_id FK "NULL, internal.player_pets.id"
        int enemy_definition_id "NOT NULL, references CSV enemy definition id logically"
        varchar(100) display_name "NOT NULL"
        varchar(255) image_path "NULL"
        int start_row "NOT NULL"
        int start_column "NOT NULL"
        int max_hp "NOT NULL"
        int max_mp "NOT NULL"
        int strength "NOT NULL"
        int defense "NOT NULL"
        int intelligence "NOT NULL"
        int luck "NOT NULL"
        int speed "NOT NULL"
        jsonb move_set_json "NOT NULL"
    }

    PET_BATTLE_RUN_PARTY_MEMBERS {
        uuid run_id PK, FK "internal.pet_battle_runs.id"
        uuid participant_id PK, FK "internal.pet_battle_run_snapshots.participant_id"
        int current_hp "NOT NULL"
        int current_mp "NOT NULL"
        boolean is_dead "NOT NULL"
        int can_act_from_turn "NOT NULL"
        int action_mode "NOT NULL (Manual/AutoAttackOnly)"
        jsonb active_effects_json "NOT NULL"
        jsonb derived_parameters_json "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }

    PET_BATTLE_TURN_COMMANDS {
        uuid run_id PK, FK "internal.pet_battle_runs.id"
        int turn_no PK "NOT NULL"
        uuid participant_id PK "NOT NULL"
        int action_kind "NOT NULL"
        int move_id "NULL"
        int target_row "NULL"
        int target_column "NULL"
        timestamptz submitted_at "NOT NULL"
        boolean is_auto_submitted "NOT NULL"
    }

    PLAYERS ||--o| PLAYER_PET_BATTLE_STATS : has
    PLAYERS ||--o{ PET_BATTLE_ROOMS : owns_as_owner
    PLAYERS ||--o{ PET_BATTLE_ROOMS : participates_as_opponent
    PET_BATTLE_ROOMS ||--o{ PET_BATTLE_ROOM_SLOTS : has
    PLAYER_PETS ||--o{ PET_BATTLE_ROOM_SLOTS : placed_in
    PET_BATTLE_ROOMS ||--o| PET_BATTLE_RUNS : generates
    PET_BATTLE_RUNS ||--o{ PET_BATTLE_RUN_SNAPSHOTS : snapshots
    PET_BATTLE_RUNS ||--o{ PET_BATTLE_RUN_PARTY_MEMBERS : tracks
    PET_BATTLE_RUNS ||--o{ PET_BATTLE_TURN_COMMANDS : receives

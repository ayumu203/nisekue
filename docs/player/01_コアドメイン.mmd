classDiagram
    %% Enum 定義は docs/common/01_Enum.mmd を参照
    %% 認証方針:
    %% - Supabase Auth の subject(sub) を PlayerId として扱う。
    %% - 匿名ログインでも subject は払い出され、初回の /player 取得時に未作成なら内部 Player を自動生成する。
    %% - 匿名ユーザーは後からメールアドレス/パスワードを紐付けて通常アカウントへ移行できる。
    namespace CoreDomain {
        %% Player の基本情報
        class Player {
            <<Entity>>
            +PlayerId Id
            +string Name
            +string? ImagePath
            +DateTimeOffset? QuestCooldownUntil
            +Job Job
            +IReadOnlySet~Job~ MasteredJobs
            +int Level
            +int Exp
            +int JobLevel
            +int JobExp
            +int Gold
            +Status Status
            +MoveSet MoveSet
            +UpdateName(name: string) void
            +UpdateImagePath(imagePath: string?) void
            +ChangeJob(nextJob: Job, nextProfile: JobProfile, learningRule: JobMoveLearningRule) IReadOnlyList~MoveId~
            +UpdateStatus(status: Status) void
            +UpdateMoveSet(moveSet: MoveSet) void
            +SetQuestCooldownUntil(until: DateTimeOffset?) void
            -ValidateName(name: string) string
            -ValidateImagePath(imagePath: string?) string?
            +GainExp(exp: int) void
            +GainGold(gold: int) void
            +SpendGold(gold: int) void
            +LevelUp(jobProfile: JobProfile, learningRule: JobMoveLearningRule) LevelUpResult
            +Rebirth(inheritedStatus: Status) void
            -CanChangeJob(nextProfile: JobProfile) bool
            -MarkCurrentJobAsMastered(jobProfile: JobProfile) bool
            -SynchronizeLearnableMoves(jobProfile: JobProfile, learningRule: JobMoveLearningRule) IReadOnlyList~MoveId~
        }

        class PlayerId {
            <<Value Object>>
            +Guid Id
        }

        class Status {
            <<Value Object>>
            +int MaxHp
            +int MaxMp
            +int Strength
            +int Defense
            +int Intelligence
            +int Luck
            +int Speed
            +int Accuracy
            +int Evasion
            +int CriticalChance
            +int DamageReduction
        }

        class EquipmentType {
            <<enumeration>>
            Weapon
            Armor
        }

        class EquipmentStatus {
            <<enumeration>>
            Inventory
            Equipped
            Broken
        }

        class EquipmentId {
            <<Value Object>>
            +int Id
        }

        class PlayerEquipmentId {
            <<Value Object>>
            +Guid Id
        }

        class Equipment {
            <<Aggregate Root>>
            +EquipmentId Id
            +string Name
            +string FlavorText
            +EquipmentType Type
            +int MaxDurability
            +int MasteryCap
            +int SynthesisGoldCost
            +EquipmentStatusBonus BonusValues
            +IReadOnlySet~Job~ EquippableJobs
            +bool CanEquip(job: Job) bool
        }

        class PlayerEquipment {
            <<Entity>>
            +PlayerEquipmentId Id
            +PlayerId PlayerId
            +EquipmentId EquipmentId
            +EquipmentType Type
            +EquipmentStatus Status
            +int Durability
            +int Mastery
            +int PlusValue
            +bool IsBroken
            +Equip(equipment: Equipment, playerJob: Job, now: DateTimeOffset) void
            +Unequip(now: DateTimeOffset) void
            +Synthesize(source: PlayerEquipment, synthesisGoldCost: int, now: DateTimeOffset) void
            -ConsumeDurability(value: int, now: DateTimeOffset) void-deprecated
            -RepairDurability(value: int, maxDurability: int, now: DateTimeOffset) void-deprecated
            +IncreaseMastery(value: int, now: DateTimeOffset) void
            +TransferOwnership(playerId: PlayerId, now: DateTimeOffset) void
        }

        class ItemId {
            <<Value Object>>
            +int Id
        }

        class Item {
            <<Aggregate Root>>
            +ItemId Id
            +string Name
            +string FlavorText
            +int MaxStack
            +StatusBonus? StatusBonus
            +StatusBonusPercent? StatusBonusPercent
            +Job? ChangeJobTo
            +int? RequiredLevel
            +IReadOnlyList~Job~ RequiredMasterJobs
        }

        class PlayerItemStackId {
            <<Value Object>>
            +Guid Id
        }

        class PlayerItemStack {
            <<Entity>>
            +PlayerItemStackId Id
            +PlayerId PlayerId
            +ItemId ItemId
            +int Quantity
            +AddQuantity(value: int) void
            +ConsumeQuantity(value: int) void
            +CanStack(item: Item) bool
        }

        class StatusBonus {
            <<Value Object>>
            +int MaxHp
            +int MaxMp
            +int Strength
            +int Defense
            +int Intelligence
            +int Luck
            +int Speed
        }

        class StatusBonusPercent {
            <<Value Object>>
            +int MaxHpPercent
            +int MaxMpPercent
            +int StrengthPercent
            +int DefensePercent
            +int IntelligencePercent
            +int LuckPercent
            +int SpeedPercent
        }

        class MarketListingId {
            <<Value Object>>
            +Guid Id
        }

        class MarketListing {
            <<Aggregate Root>>
            +MarketListingId Id
            +PlayerId SellerId
            +PlayerEquipmentId? PlayerEquipmentId
            +ItemId? ItemId
            +string ItemName
            +string FlavorText
            +int Quantity
            +int RemainingQuantity
            +int UnitPrice
            +DateTimeOffset ListedAt
            +DateTimeOffset ExpiresAt
            +bool IsExpired(now: DateTimeOffset) bool
            +Purchase(quantity: int, now: DateTimeOffset) void
            +Expire(now: DateTimeOffset) void
        }

        class MarketTradeHistory {
            <<Entity>>
            +Guid Id
            +PlayerId SellerId
            +PlayerId BuyerId
            +string ItemIdentifier
            +int Quantity
            +int UnitPrice
            +DateTimeOffset PurchasedAt
        }

        class ItemDeletionLog {
            <<Entity>>
            +Guid Id
            +PlayerId PlayerId
            +string ItemIdentifier
            +int Quantity
            +string Reason
            +DateTimeOffset DeletedAt
        }

        class EquipmentStatusResolver {
            <<Domain Service>>
            +BuildEffectiveStatus(baseStatus: Status, playerJob: Job, playerEquipments: IEnumerable~PlayerEquipment~, equipments: IEnumerable~Equipment~) Status
        }

        class StatusRankThreshold {
            <<Value Object>>
            +string StatusKey
            +StatusRank Rank
            +int MaxValue
        }

        class CombatIndexWeight {
            <<Value Object>>
            +string StatusKey
            +double Weight
        }

        class StatusRankEvaluator {
            <<Domain Service>>
            +Evaluate(statusKey: string, value: int) StatusRank
        }

        class CombatIndexCalculator {
            <<Domain Service>>
            +Calculate(status: Status) int
        }

        class CombatIndexRankEvaluator {
            <<Domain Service>>
            +Evaluate(combatIndex: int) StatusRank
        }

        class PaginationQuery {
            <<Value Object>>
            +int? Page
            +int? PageSize
            +int? Limit
            +ValidatePair() void
            +ResolveOffsetAndLimit() (int? Offset, int? Limit)
        }

        class PlayerForUpdateLockService {
            <<Infrastructure Service>>
            +Task~IReadOnlyDictionary~Guid, PlayerEntity~~ LockPlayersAsync(dbContext: AppDbContext, playerIds: IEnumerable~Guid~)
            +Task~PlayerEntity~ LockPlayerAsync(dbContext: AppDbContext, playerId: Guid)
        }

        class EquipmentStatusBonus {
            <<Value Object>>
            +int MaxHp
            +int MaxMp
            +int Strength
            +int Defense
            +int Intelligence
            +int Luck
            +int Speed
        }

        class GrowthValue {
            <<Value Object>>
            +int MaxHp
            +int MaxMp
            +int Strength
            +int Defense
            +int Intelligence
            +int Luck
            +int Speed
        }

        class JobProfile {
            <<Value Object>>
            +Job Job
            +string Description
            +int MasterLevel
            +IReadOnlyList~Job~ RequiredMasterJobs
        }

        class LevelUpResult {
            <<Value Object>>
            +bool HasLeveledUp
            +bool HasMasteredCurrentJob
            +IReadOnlyList~MoveId~ NewlyLearnedMoveIds
        }

        class MoveSet {
            <<Value Object>>
            +IReadOnlyList~MoveId?~ Slots
            +SetSlot(index: int, moveId: MoveId?) void
            +GetSlot(index: int) MoveId?
            +GetLearnedMoveIds() IReadOnlyList~MoveId~
            +Contains(moveId: MoveId) bool
            +AddLearnedMove(moveId: MoveId) void
            +GetFirstEmptySlotIndex() int?
            +ClearSlot(index: int) void
            +SwapSlots(fromIndex: int, toIndex: int) void
            -DropOldestMoveBySetLimit() void
        }

        class IPlayerRepository {
            +Task~Player?~ GetPlayerAsync(id: PlayerId)
            +Task~Player?~ GetPlayerWithinLevelCapAsync(id: PlayerId, maxLevel: int)
            +Task~IReadOnlyList~Player~~ GetPvpOpponentsAsync(excludeId: PlayerId, maxLevel: int, offset: int?, limit: int?)
            +Task~(IReadOnlyList~Player~ Opponents, int TotalCount)~ GetPvpOpponentsPageAsync(excludeId: PlayerId, maxLevel: int, offset: int?, limit: int?)
            +Task~int~ CountPvpOpponentsAsync(excludeId: PlayerId, maxLevel: int)
            +Task~IReadOnlyList~Player~~ GetPlayersAsync(ids: IEnumerable~PlayerId~)
            +Task~(IReadOnlyList~Player~ Players, int TotalCount)~ GetPlayersPageExcludingAsync(excludeId: PlayerId, offset: int?, limit: int?)
            +Task~IReadOnlyList~Player~~ GetAllAsync(offset: int?, limit: int?)
            +Task~int~ CountAllAsync()
            +Task~bool~ UpdateNameAsync(id: PlayerId, name: string)
            +Task~DateTimeOffset?~ TryStartTrainingCooldownAsync(id: PlayerId, nowUtc: DateTimeOffset, cooldown: TimeSpan)
            +Task SaveAsync(player: Player)
        }

        note for IPlayerRepository "GetPvpOpponentsAsync / GetPvpOpponentsPageAsync\nは Level昇順 -> Name昇順 -> Id昇順で返す"

        class IEquipmentRepository {
            +Task~Equipment?~ GetAsync(id: EquipmentId)
            +Task~IReadOnlyList~Equipment~~ GetAllAsync()
        }

        class IPlayerEquipmentRepository {
            +Task~IReadOnlyList~PlayerEquipment~~ GetByPlayerAsync(playerId: PlayerId)
            +Task~PlayerEquipment?~ GetAsync(playerEquipmentId: PlayerEquipmentId)
            +Task SaveAsync(playerEquipments: IReadOnlyList~PlayerEquipment~)
        }

        class IItemRepository {
            +Task~Item?~ GetAsync(id: ItemId)
            +Task~IReadOnlyList~Item~~ GetAllAsync()
        }

        class IPlayerItemStackRepository {
            +Task~IReadOnlyList~PlayerItemStack~~ GetByPlayerAsync(playerId: PlayerId)
            +Task SaveAsync(playerItemStacks: IReadOnlyList~PlayerItemStack~)
        }

        class IMarketListingRepository {
            +Task~MarketListing?~ GetAsync(id: MarketListingId)
            +Task~IReadOnlyList~MarketListing~~ GetActiveAsync()
            +Task~IReadOnlyList~MarketListing~~ GetBySellerAsync(playerId: PlayerId)
            +Task SaveAsync(listing: MarketListing)
            +Task DeleteAsync(id: MarketListingId)
        }

        class IMarketTradeHistoryRepository {
            +Task AddAsync(history: MarketTradeHistory)
        }

        class IItemDeletionLogRepository {
            +Task AddAsync(log: ItemDeletionLog)
        }

        class IJobProfileRepository {
            +JobProfile GetByJob(job: Job)
            +IReadOnlyList~JobProfile~ GetAll()
        }

        class IStatusRankThresholdRepository {
            <<Repository>>
            +IReadOnlyList~StatusRankThreshold~ GetAll()
        }

        class ICombatIndexWeightRepository {
            <<Repository>>
            +IReadOnlyList~CombatIndexWeight~ GetAll()
        }

        class ICombatIndexRankThresholdRepository {
            <<Repository>>
            +IReadOnlyList~StatusRankThreshold~ GetAll()
        }
    }

    PlayerForUpdateLockService ..> Player : lock順序を統一した更新前ロック

    Player *-- PlayerId : has
    Player *-- Status : has
    Player *-- MoveSet : has
    PlayerEquipment *-- PlayerEquipmentId : has
    PlayerEquipment ..> Equipment : refers
    PlayerEquipment ..> EquipmentStatus : has
    Equipment *-- EquipmentId : has
    Equipment ..> EquipmentType : has
    Equipment *-- EquipmentStatusBonus : has
    PlayerItemStack *-- PlayerItemStackId : has
    PlayerItemStack ..> Item : refers
    Item *-- ItemId : has
    Item *-- StatusBonus : has
    Item *-- StatusBonusPercent : has
    MarketListing *-- MarketListingId : has
    MarketListing ..> PlayerEquipmentId : may sell
    MarketListing ..> ItemId : may sell
    Player ..> JobMoveLearningRule : uses
    Player ..> LevelUpResult : returns
    EquipmentStatusResolver ..> Equipment : uses
    EquipmentStatusResolver ..> PlayerEquipment : uses
    StatusRankEvaluator ..> IStatusRankThresholdRepository : uses
    CombatIndexCalculator ..> ICombatIndexWeightRepository : uses
    CombatIndexRankEvaluator ..> ICombatIndexRankThresholdRepository : uses
    StatusRankThreshold ..> StatusRank : has
    IJobProfileRepository ..> JobProfile : returns
    IPlayerRepository ..> Player : stores/loads
    IEquipmentRepository ..> Equipment : stores/loads
    IPlayerEquipmentRepository ..> PlayerEquipment : stores/loads
    IItemRepository ..> Item : stores/loads
    IPlayerItemStackRepository ..> PlayerItemStack : stores/loads
    IMarketListingRepository ..> MarketListing : stores/loads
    IMarketTradeHistoryRepository ..> MarketTradeHistory : stores
    IItemDeletionLogRepository ..> ItemDeletionLog : stores
    IStatusRankThresholdRepository ..> StatusRankThreshold : stores/loads
    ICombatIndexWeightRepository ..> CombatIndexWeight : stores/loads
    ICombatIndexRankThresholdRepository ..> StatusRankThreshold : stores/loads

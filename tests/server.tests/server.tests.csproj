<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.6" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\server\server.csproj" />
  </ItemGroup>

  <!--
    テストはスプレッドシートの最新データではなく、fixtures/resources に固定したテスト用 CSV で動かす。
    server プロジェクトから出力先へコピーされた resources/*.csv を、ビルドのたびにテスト用 CSV で上書きする。
    本物のマスタデータで整合性テストを回すときは -p:UseMasterDataFixtures=false を付ける
    （切り替えるときは出力先に前回の CSV が残らないよう、クリーンな状態でビルドする）。
  -->
  <PropertyGroup>
    <UseMasterDataFixtures Condition="'$(UseMasterDataFixtures)' == ''">true</UseMasterDataFixtures>
  </PropertyGroup>

  <ItemGroup>
    <MasterDataFixture Include="fixtures\resources\**\*.csv" />
  </ItemGroup>

  <Target Name="CopyMasterDataFixtures" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(UseMasterDataFixtures)' == 'true'">
    <Copy SourceFiles="@(MasterDataFixture)" DestinationFiles="@(MasterDataFixture->'$(OutDir)resources\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
